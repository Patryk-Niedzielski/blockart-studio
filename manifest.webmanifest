{
  "name": "BlockArt Studio",
  "short_name": "BlockArt",
  "description": "Turn any picture into Minecraft block pixel art \u2013 .schem & .litematic export.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0f1116",
  "theme_color": "#14161c",
  "categories": [
    "games",
    "graphics",
    "utilities"
  ],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "image/*": [
          ".png",
          ".jpg",
          ".jpeg",
          ".webp",
          ".gif",
          ".bmp"
        ]
      }
    }
  ]
}